generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// AUTENTICAÇÃO E USUÁRIOS
// ─────────────────────────────────────────

model Usuario {
  id                     String              @id @default(uuid())
  nome                   String
  email                  String              @unique
  avatarUrl              String?
  googleId               String              @unique
  role                   Role                @default(PARTICIPANTE)
  ativo                  Boolean             @default(true)
  criadoEm               DateTime            @default(now())
  atualizadoEm           DateTime            @updatedAt
  comunidadesCriadas     Int                 @default(0)
  
  // Relações Virtuais do Módulo de Comunidades
  comunidadesPossuidas      Comunidade[]        @relation("donoComunidade")
  convitesComunidadeCriados ConviteComunidade[] @relation("criadorConvite")
  comunidades               MembroComunidade[]
  solicitacoesComunidade    SolicitacaoComunidade[]

  // Palpites
  palpites                  Palpite[]
  palpitesEspeciais         PalpiteEspecial[]

  // Notificações push
  pushSubscriptions         PushSubscription[]

  // Módulo Proposta 2 — Grafo de Confrontos
  confrontosComoPerdedor Confronto[]         @relation("perdedor")
  confrontosComoVencedor Confronto[]         @relation("vencedor")

  // Módulo Proposta 4 — DAG de Estados
  estadosRodada          EstadoRodada[]

  @@map("usuarios")
}

// ─────────────────────────────────────────
// COPA DO MUNDO — TIMES E GRUPOS
// ─────────────────────────────────────────

model Time {
  id                          String              @id @default(uuid())
  nome                        String              @unique
  codigo                      String?
  grupo                       String?
  apiFootballId               Int?                @unique
  jogosCasa                   Jogo[]              @relation("timeCasa")
  jogosVisitante              Jogo[]              @relation("timeVisitante")
  jogadores                   Jogador[]
  palpitesEspeciaisComoTime   PalpiteEspecial[]
  resultadosEspeciaisComoTime ResultadoEspecial[]

  @@map("times")
}

model Jogador {
  id                                String   @id @default(uuid())
  name                              String
  apiFootballId                     Int      @unique
  timeId                            String
  position                          String?
  numero                            Int?
  fotoUrl                           String?
  criadoEm                          DateTime @default(now())
  time                              Time     @relation(fields: [timeId], references: [id])
  palpitesEspeciaisComoArtilheiro   PalpiteEspecial[]   @relation("artilheiroPalpite")
  resultadosEspeciaisComoArtilheiro ResultadoEspecial[] @relation("artilheiroResultado")

  @@index([timeId])
  @@index([name])
  @@map("jogadores")
}

// ─────────────────────────────────────────
// JOGOS
// ─────────────────────────────────────────

model Jogo {
  id               String         @id @default(uuid())
  num              Int?
  fase             Fase
  rodada           String
  grupo            String?
  dataHora         DateTime
  local            String
  timeCasaId       String?
  timeVisitanteId  String?
  timeCasaRef      String?
  timeVisitanteRef String?
  status           StatusJogo     @default(AGENDADO)
  confrontos       Confronto[]
  estadosRodada    EstadoRodada[]
  timeCasa         Time?          @relation("timeCasa", fields: [timeCasaId], references: [id])
  timeVisitante    Time?          @relation("timeVisitante", fields: [timeVisitanteId], references: [id])
  palpites         Palpite[]
  resultado        Resultado?

  @@map("jogos")
}

// ─────────────────────────────────────────
// RESULTADOS
// ─────────────────────────────────────────

model Resultado {
  id                          String    @id @default(uuid())
  jogoId                      String    @unique
  golsCasa                    Int
  golsVisitante               Int
  penalti                     Boolean   @default(false)
  vencedorPenalti             String?   // 'CASA' | 'VISITANTE'
  cartoesAmarelos             Int       @default(0)
  cartoesVermelhosIndiretos   Int       @default(0)
  cartoesVermelhosDiretos     Int       @default(0)
  cartoesAmarelosMaisVermelho Int       @default(0)
  inseridoEm                  DateTime  @default(now())
  inseridoPor                 String
  artilheirosCasa             String[]  @default([])
  artilheirosVisitante        String[]  @default([])
  palpites                    Palpite[]
  jogo                        Jogo      @relation(fields: [jogoId], references: [id])

  @@map("resultados")
}

// ─────────────────────────────────────────
// PALPITES
// ─────────────────────────────────────────

model Palpite {
  id              String        @id @default(uuid())
  usuarioId       String
  jogoId          String
  resultadoId     String?
  golsCasa        Int
  golsVisitante   Int
  vencedorPenalti String?       
  pontos          Int           @default(0)
  status          StatusPalpite @default(PENDENTE)
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt
  totalEdicoes    Int           @default(0)
  confrontos    Confronto[]
  jogo          Jogo          @relation(fields: [jogoId], references: [id])
  resultado     Resultado?    @relation(fields: [resultadoId], references: [id])
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, jogoId])
  @@map("palpites")
}

model PalpiteEspecial {
  id           String              @id @default(uuid())
  usuarioId    String
  tipo         TipoPalpiteEspecial
  timeId       String?             
  jogadorId    String?             
  totalEdicoes Int                 @default(0)
  pontos       Int                 @default(0)
  acertou      Boolean?
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt
  usuario      Usuario             @relation(fields: [usuarioId], references: [id])
  time         Time?               @relation(fields: [timeId], references: [id])
  jogador      Jogador?            @relation("artilheiroPalpite", fields: [jogadorId], references: [id])

  @@unique([usuarioId, tipo])
  @@map("palpites_especiais")
}

model ResultadoEspecial {
  id          String              @id @default(uuid())
  tipo        TipoPalpiteEspecial @unique
  timeId      String?
  jogadorId   String?
  inseridoEm  DateTime            @default(now())
  inseridoPor String
  time        Time?               @relation(fields: [timeId], references: [id])
  jogador     Jogador?            @relation("artilheiroResultado", fields: [jogadorId], references: [id])

  @@map("resultados_especiais")
}

// ─────────────────────────────────────────
// MÓDULO COMUNIDADES
// ─────────────────────────────────────────

model Comunidade {
  id                String              @id @default(uuid())
  nome              String
  descricao         String?
  tipo              TipoComunidade      @default(PUBLICA)
  avatarUrl         String?
  codigoCovite      String?             @unique
  donoId            String
  ativo             Boolean             @default(true)
  rankingFaseInicio Fase?
  criadoEm          DateTime            @default(now())
  atualizadoEm      DateTime            @updatedAt
  convites          ConviteComunidade[]
  membros           MembroComunidade[]
  solicitacoesComunidade SolicitacaoComunidade[]

  dono              Usuario             @relation("donoComunidade", fields: [donoId], references: [id])

  @@map("comunidades")
}

model MembroComunidade {
  id           String         @id @default(uuid())
  comunidadeId String
  usuarioId    String
  role         RoleComunidade @default(MEMBRO)
  entradoEm    DateTime       @default(now())
  comunidade   Comunidade     @relation(fields: [comunidadeId], references: [id])
  usuario      Usuario        @relation(fields: [usuarioId], references: [id])

  @@unique([comunidadeId, usuarioId])
  @@map("membros_comunidade")
}

model ConviteComunidade {
  id           String     @id @default(uuid())
  comunidadeId String
  criadoPorId  String
  codigo       String     @unique @default(cuid())
  usos         Int        @default(0)
  maxUsos      Int?
  expiradoEm   DateTime?
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  comunidade   Comunidade @relation(fields: [comunidadeId], references: [id])
  
  // Mapeamento virtual do criador do convite
  criadoPor    Usuario    @relation("criadorConvite", fields: [criadoPorId], references: [id])

  @@map("convites_comunidade")
}

model SolicitacaoComunidade {
  id           String                  @id @default(uuid())
  comunidadeId String
  usuarioId    String
  status       StatusSolicitacao       @default(PENDENTE)
  criadoEm    DateTime                @default(now())
  atualizadoEm DateTime               @updatedAt

  comunidade   Comunidade              @relation(fields: [comunidadeId], references: [id])
  usuario      Usuario                 @relation(fields: [usuarioId], references: [id])

  @@unique([comunidadeId, usuarioId])
  @@map("solicitacoes_comunidade")
}

// ─────────────────────────────────────────
// MÓDULO PROPOSTA 2 — GRAFO DE CONFRONTOS
// ─────────────────────────────────────────

model Confronto {
  id         String   @id @default(uuid())
  jogoId     String
  vencedorId String
  perdedorId String
  palpiteId  String
  peso       Int      @default(1)
  criadoEm   DateTime @default(now())
  jogo       Jogo     @relation(fields: [jogoId], references: [id])
  palpite    Palpite  @relation(fields: [palpiteId], references: [id])
  perdedor   Usuario  @relation("perdedor", fields: [perdedorId], references: [id])
  vencedor   Usuario  @relation("vencedor", fields: [vencedorId], references: [id])

  @@unique([jogoId, vencedorId, perdedorId])
  @@map("confrontos")
}

model PageRankSnapshot {
  id          String   @id @default(uuid())
  usuarioId   String
  rodada      String?
  score       Float
  ranking     Int
  calculadoEm DateTime @default(now())

  @@map("pagerank_snapshots")
}

model CicloDetectado {
  id            String   @id @default(uuid())
  rodada        String?
  participantes String
  tamanho       Int
  detectadoEm   DateTime @default(now())

  @@map("ciclos_detectados")
}

// ─────────────────────────────────────────
// MÓDULO PROPOSTA 4 — DAG DE ESTADOS
// ─────────────────────────────────────────

model EstadoRodada {
  id               String  @id @default(uuid())
  usuarioId        String
  jogoId           String
  rodada           String
  totalPontos      Int     @default(0)
  percentualAcerto Float   @default(0)
  melhorou         Boolean @default(false)
  jogo             Jogo    @relation(fields: [jogoId], references: [id])
  usuario          Usuario @relation(fields: [usuarioId], references: [id])

  @@map("estados_rodada")
}

// ─────────────────────────────────────────
// MÓDULO PROPOSTA 5 — CLIQUES E PANELINHAS
// ─────────────────────────────────────────

model AcertoCompartilhado {
  id         String   @id @default(uuid())
  jogoId     String
  usuarioId  String
  tipoAcerto String
  criadoEm   DateTime @default(now())

  @@unique([jogoId, usuarioId])
  @@map("acertos_compartilhados")
}

model CliqueSnapshot {
  id          String   @id @default(uuid())
  rodada      String?
  membros     String
  tamanho     Int
  tipo        String
  calculadoEm DateTime @default(now())

  @@map("clique_snapshots")
}

// ─────────────────────────────────────────
// MÓDULO PUSH NOTIFICATIONS
// ─────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  usuarioId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("push_subscriptions")
}

// ─────────────────────────────────────────
// ENUMS GLOBAIS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  PARTICIPANTE
}

enum Fase {
  GRUPOS
  ROUND_OF_32
  ROUND_OF_16
  QUARTAS
  SEMIFINAL
  TERCEIRO_LUGAR
  FINAL
}

enum StatusJogo {
  AGENDADO
  EM_ANDAMENTO
  ENCERRADO
  BLOQUEADO
}

enum StatusPalpite {
  PENDENTE
  ACERTO_PLACAR
  ACERTO_VENCEDOR
  ACERTO_BONUS
  ERRO
}

enum TipoPalpiteEspecial {
  CAMPEAO
  VICE
  TERCEIRO_LUGAR
  ARTILHEIRO
  MVP
}

enum TipoComunidade {
  PUBLICA
  PRIVADA
}

enum RoleComunidade {
  DONO
  MODERADOR
  MEMBRO
}

enum StatusSolicitacao {
  PENDENTE
  ACEITA
  REJEITADA
}